# Local model file (skip network download in air-gapped environments)
# NEMO_MODEL_PATH=/models/parakeet-tdt-0.6b-v2.nemo

# Audio processing
TARGET_SAMPLE_RATE=16000

# Performance settings
MODEL_PRECISION=fp16
DEVICE=cuda
BATCH_SIZE=4
MAX_AUDIO_DURATION=30
VAD_THRESHOLD=0.5
PROCESSING_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
